# ============================================================
# .gitignore —— 告诉 Git："这些文件别管，别上传"
# 每一行都是一个「忽略规则」：* 表示任意字符，** 表示任意层级目录
# ============================================================

# ---------- 操作系统垃圾文件 ----------
.DS_Store            # macOS 文件夹配置文件
._*                  # macOS 资源分支文件
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE 配置 ----------
.vscode/             # VS Code（保留 .vscode/settings.json 可自行调整）
.idea/               # JetBrains 系列（PyCharm / IDEA）
*.swp                # Vim 临时文件
*~

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/  # Jupyter 自动保存点
*.ipynb_checkpoints
.Python
env/
venv/
.venv/
ENV/

# ---------- Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
.parcel-cache/
dist/
.next/
out/
coverage/

# ---------- 数据科学 / AI 常用中间产物 ----------
# 数据可能很大或有隐私，默认不入库
data/raw/
data/*.csv
data/*.xlsx
*.parquet
*.pkl
*.joblib
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.safetensors
*.gguf
*.onnx
runs/
logs/
wandb/
tensorboard/
outputs/
results/tmp/

# ---------- 环境变量与密钥（极其重要！）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa
id_rsa.pub
credentials.json
secrets.yaml
*.token

# ---------- 压缩/临时文件 ----------
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.log
*.tmp
*.temp

# ---------- 本仓库保留的小文件锚点 ----------
# .gitkeep 的作用：让空目录也能被 Git 记录（Git 本身不追踪空文件夹）
!**/.gitkeep
!assets/
!docs/
